# Copy to .env and fill in. .env is gitignored; this template is not.
#
# NOTE: nothing in the code reads .env automatically (no python-dotenv).
# Load it into the environment before running:
#
#   set -a; source .env; set +a
#   python run.py daily
#
# ---------------------------------------------------------------------------
# LLM gateway — must speak OpenAI-compatible /chat/completions.
# grant_sift/llm.py POSTs to  ${BASE_URL}/chat/completions  with
#   Authorization: Bearer ${API_KEY}
# and reads  choices[0].message.content
#
# BASE_URL is the prefix WITHOUT /chat/completions -- the client appends it.
# If the docs give you .../v1/chat/completions, set the var to .../v1
# ---------------------------------------------------------------------------
GRANT_SIFT_LLM_BASE_URL=
GRANT_SIFT_LLM_API_KEY=
GRANT_SIFT_LLM_MODEL=
GRANT_SIFT_LLM_TIMEOUT=120

# ---------------------------------------------------------------------------
# Digest email. Only needed for `run.py digest --send`.
# ---------------------------------------------------------------------------
GRANT_SIFT_SMTP_HOST=localhost
GRANT_SIFT_FROM=grant-sift@ncsa.illinois.edu

# Path to the SQLite file. All pipeline state lives here.
GRANT_SIFT_DB=grant-sift.db
