# Secrets. The gateway key lives in .env and must never be committed.
# .env.example is the documented template and IS tracked, hence the negation.
.env
.env.*
!.env.example
.envrc
secrets.yaml
secrets.yml
*.pem
*.key
credentials.json
helm/**/values-secrets.yaml
helm/**/charts/
!helm/**/Chart.lock

# Deployment roster: real collaborator names/status. Ship the example only.
config/roster.yaml
# Our own staff and their addresses. Same rule as the roster: the example is
# tracked, the real file is not.
config/ncsa_staff.yaml
# Transient import artefact from scripts/build_contacts.py, merged by
# scripts/build_roster.py and then deletable.
config/contacts.yaml
# Scraped Illinois Experts pages, rebuildable with scripts/crawl_areas.py
.cache/

